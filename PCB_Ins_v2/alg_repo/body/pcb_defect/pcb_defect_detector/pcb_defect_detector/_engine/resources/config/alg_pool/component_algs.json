      "idle_timeout": 600,
      "timeout": 120,
      "config_path": "./resources/config/alg/component/component_tombstone.json"
    },
    {
      "algorithm_code": "component_flipped",
      "class_path": "algorithms.component.flipped.algo_trad.ComponentFlippedTradAlg",
