      "idle_timeout": 600,
      "timeout": 120,
      "config_path": "./resources/config/alg/component/component_flipped.json"
    },
    {
      "algorithm_code": "component_reverse_polarity",
      "class_path": "algorithms.component.reverse_polarity.algo_trad.ComponentReversePolarityTradAlg",
      "description": "元件极反检测：丝印+色带+灯芯 三路联合(无OCR)",
      "idle_timeout": 600,
      "timeout": 120,
      "config_path": "./resources/config/alg/component/component_reverse_polarity.json"
    },
    {
      "algorithm_code": "component_damage",
      "class_path": "algorithms.component.damage.algo_trad.ComponentDamageTradAlg",
      "description": "元件破损检测：SSIM差异+轮廓比对，先精对齐再判破损",
      "idle_timeout": 600,
      "timeout": 120,
      "config_path": "./resources/config/alg/component/component_damage.json"
    }
  ]
