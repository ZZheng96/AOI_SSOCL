      "idle_timeout": 600,
      "timeout": 120,
      "config_path": "./resources/config/alg/component/component_wrong_part.json"
    },
    {
      "algorithm_code": "component_missing",
      "class_path": "algorithms.component.missing.algo_trad.ComponentMissingTradAlg",
      "description": "元件缺件检测：本体像素比+差分+边缘+暗色通道 联合判定",
      "idle_timeout": 600,
      "timeout": 120,
      "config_path": "./resources/config/alg/component/component_missing.json"
    },
    {
      "algorithm_code": "component_shift",
      "class_path": "algorithms.component.shift.algo_trad.ComponentShiftTradAlg",
      "description": "元件移位检测：ROI位姿估计 dx/dy/theta 超公差",
      "idle_timeout": 600,
      "timeout": 120,
      "config_path": "./resources/config/alg/component/component_shift.json"
    },
    {
      "algorithm_code": "component_tombstone",
      "class_path": "algorithms.component.tombstone.algo_trad.ComponentTombstoneTradAlg",
